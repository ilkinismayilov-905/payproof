# Copy to .env (scripts/setup.sh does it). Never commit real secrets.
ENV=dev

# --- API ---
DATABASE_URL=postgresql+asyncpg://payproof:payproof@localhost:5432/payproof
JWT_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=20
MAX_PAGES=50

# --- Storage (MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=payproof
S3_SECRET_KEY=payproof-secret
S3_BUCKET=payproof-docs
SIGNED_URL_TTL_SECONDS=300

# --- Extraction / AI ---
# mock | pdf | llm   (mock = pre-processed results, labelled in UI)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Frontends ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
