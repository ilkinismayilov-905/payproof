# Copy to .env (scripts/setup.sh does it). Never commit real secrets.
ENV=dev

# --- Postgres (docker-compose; must match DATABASE_URL) ---
POSTGRES_USER=payproof
POSTGRES_PASSWORD=payproof
POSTGRES_DB=payproof
POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgresql+asyncpg://payproof:payproof@localhost:5432/payproof
JWT_SECRET=dev-only-change-me
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=20
MAX_PAGES=50

# --- Storage (MinIO locally) ---
# MINIO_PORT must match the port in S3_ENDPOINT_URL
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=payproof
S3_SECRET_KEY=payproof-secret
S3_BUCKET=payproof-docs
SIGNED_URL_TTL_SECONDS=300

# --- Extraction / AI ---
# mock | pdf | llm   (mock = pre-processed results, labelled in UI)
AI_PROVIDER=mock
# llm: Claude reads the PDF/image itself; no key or an API error → fields stay UNKNOWN (manual entry)
AI_API_KEY=
# empty → claude-opus-5-5
AI_MODEL=
AI_TIMEOUT_S=60

# --- Frontends ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
