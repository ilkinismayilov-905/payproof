{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packages.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "invoice_number",
      "customer_id",
      "currency",
      "invoice_date",
      "created_at",
      "owner_id",
      "version",
      "processing",
      "invoice",
      "order_link",
      "candidates",
      "delivery",
      "signature_reviewed",
      "documents",
      "approvals",
      "exports"
    ],
    "properties": {
      "id": {
        "$ref": "defs.json#/$defs/package_id"
      },
      "invoice_number": {
        "$ref": "defs.json#/$defs/invoice_number"
      },
      "customer_id": {
        "$ref": "defs.json#/$defs/customer_id"
      },
      "currency": {
        "$ref": "defs.json#/$defs/currency"
      },
      "invoice_date": {
        "$ref": "defs.json#/$defs/date"
      },
      "created_at": {
        "$ref": "defs.json#/$defs/datetime"
      },
      "owner_id": {
        "$ref": "defs.json#/$defs/user_id"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "processing": {
        "type": "boolean"
      },
      "invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": ["po_ref", "po_raw", "unreadable_fields", "total", "lines"],
        "properties": {
          "po_ref": {
            "type": ["string", "null"],
            "description": "Extracted PO; may be a PO that does not exist (INV-1043)"
          },
          "po_raw": {
            "type": ["string", "null"],
            "description": "Raw OCR text when the field was unreadable"
          },
          "unreadable_fields": {
            "type": "array",
            "items": {
              "enum": ["po_ref"]
            }
          },
          "total": {
            "$ref": "defs.json#/$defs/money"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "defs.json#/$defs/priced_line"
            }
          }
        }
      },
      "order_link": {
        "type": "object",
        "additionalProperties": false,
        "required": ["po_number", "confirmed", "confirmed_by", "method"],
        "properties": {
          "po_number": {
            "anyOf": [
              {
                "$ref": "defs.json#/$defs/po_number"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmed": {
            "type": "boolean"
          },
          "confirmed_by": {
            "anyOf": [
              {
                "$ref": "defs.json#/$defs/actor_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "enum": ["exact_id", "human", null]
          }
        }
      },
      "candidates": {
        "type": "array",
        "description": "AI link suggestions — never evidence by themselves",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["po_number", "reason"],
          "properties": {
            "po_number": {
              "$ref": "defs.json#/$defs/po_number"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "delivery": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "note_number",
              "po_ref",
              "customer_id",
              "delivery_date",
              "signed",
              "lines"
            ],
            "properties": {
              "note_number": {
                "type": "string",
                "pattern": "^TS-[0-9]+$"
              },
              "po_ref": {
                "$ref": "defs.json#/$defs/po_number"
              },
              "customer_id": {
                "$ref": "defs.json#/$defs/customer_id"
              },
              "delivery_date": {
                "$ref": "defs.json#/$defs/date"
              },
              "signed": {
                "type": "boolean"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "defs.json#/$defs/qty_line"
                }
              }
            }
          }
        ]
      },
      "signature_reviewed": {
        "type": "boolean"
      },
      "documents": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "versions"],
          "properties": {
            "type": {
              "$ref": "defs.json#/$defs/document_type"
            },
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version_no",
                  "file_name",
                  "sha256",
                  "source_kind",
                  "uploaded_by",
                  "uploaded_at",
                  "status"
                ],
                "properties": {
                  "version_no": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "file_name": {
                    "type": "string"
                  },
                  "sha256": {
                    "$ref": "defs.json#/$defs/sha256"
                  },
                  "source_kind": {
                    "enum": ["pdf", "scan", "spreadsheet"]
                  },
                  "uploaded_by": {
                    "$ref": "defs.json#/$defs/user_id"
                  },
                  "uploaded_at": {
                    "$ref": "defs.json#/$defs/datetime"
                  },
                  "status": {
                    "enum": ["PROCESSING", "EXTRACTED", "REVIEW_REQUIRED", "FAILED"]
                  },
                  "signed": {
                    "type": "boolean",
                    "description": "Delivery versions only"
                  }
                }
              }
            }
          }
        }
      },
      "approvals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_version",
            "requirement_set_version",
            "approver_id",
            "created_at",
            "valid",
            "invalidated_reason",
            "invalidated_at"
          ],
          "properties": {
            "package_version": {
              "type": "integer",
              "minimum": 1
            },
            "requirement_set_version": {
              "type": "integer",
              "minimum": 1
            },
            "approver_id": {
              "$ref": "defs.json#/$defs/user_id"
            },
            "created_at": {
              "$ref": "defs.json#/$defs/datetime"
            },
            "valid": {
              "type": "boolean"
            },
            "invalidated_reason": {
              "type": ["string", "null"]
            },
            "invalidated_at": {
              "anyOf": [
                {
                  "$ref": "defs.json#/$defs/datetime"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "exports": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_version",
            "requirement_set_version",
            "created_by",
            "created_at",
            "files"
          ],
          "properties": {
            "package_version": {
              "type": "integer",
              "minimum": 1
            },
            "requirement_set_version": {
              "type": "integer",
              "minimum": 1
            },
            "created_by": {
              "$ref": "defs.json#/$defs/user_id"
            },
            "created_at": {
              "$ref": "defs.json#/$defs/datetime"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
