{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "products.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "description", "unit"],
    "properties": {
      "code": { "$ref": "defs.json#/$defs/product_code" },
      "description": { "type": "string" },
      "unit": { "type": "string" }
    }
  }
}
